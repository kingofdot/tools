      "allbaro_required": "법 제25조제5항제2~7호 처리업 + 법 제46조제1항제1호 처리신고자는 장부기록사항 올바로 의무입력(발생일부터 10일 내) — 법 제36조제3항, 시행규칙 제58조제3항·별표15의2"
    },
    "download_note": "download_url 은 https://www.law.go.kr + 상대경로. 최신 서식 파일로 리다이렉트됨.",
    "schema": {
      "subjects[]": "선택지(업종·신고 주체). branches 가 있으면 질문 후 when 조건으로 ledgers 필터",
      "ledgers[].when": "null(키없음) 이면 항상 포함. {branch,value} 면 해당 답변일 때만 포함",
      "forms{}": "form_id 로 참조되는 별지서식 상세",
      "allbaro_required": "true=올바로 의무입력 / false=대상아님 / null=겸영 여부에 따라 달라짐"
    }
  },
