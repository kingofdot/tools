  "_meta": {
    "_note": "표 내 값에 포함된 알파벳 기호는 연료의 조성 변수를 의미함. S = 연료 중 황 함량(%), A = 연료 중 회분 함량(%). 예: '17.0S'는 17.0 × (황 함량 %)을 의미.",
    "오염물질": [
      "먼지",
      "황산화물",
      "질소산화물"
    ],
    "valueTypes": {
      "constant": "{type:'constant',   value}",
      "range": "{type:'range',      min, max}",
      "qualifier": "{type:'qualifier',  op, value}      // op: '<=' | '>=' | '<' | '>'",
      "expression": "{type:'expression', coefficient, variable, variableMeaning}  // result = coefficient × variable",
      "null": "데이터 없음 (해당 오염물질 미적용)"
    },
    "unitSchema": {
      "raw": "원본 표기 (예: 'kg/폴리프로필렌생산량(ton)')",
      "numerator": "배출량 단위 (kg 등)",
      "denominator": "단위량의 단위 (ton, ㎘, 10³㎥, m², 109J 등)",
      "basis": "단위량의 의미 (생산량 | 사용량 | 처리량 | 소각량 | 회수량 | 저장량 | 투입량 | null)"
    },
    "calculationFormula": "시간당 발생량(kg/h) = factor.value × 시간당 단위량 (factor.type 별 평가 방법은 valueTypes 참조)",
    "basisVocabulary": [
      "생산량",
      "사용량",
      "처리량",
      "소각량",
      "회수량",
      "저장량",
      "투입량"
    ],
    "materialTypeRules": {
      "제품": "basis ∈ {생산량, 회수량}",
      "원료": "basis ∈ {사용량, 저장량, 투입량, 처리량}",
      "폐기물": "basis = 소각량",
      "연료": "단위에 한글 basis 가 없는 연료성 단위 (kg/ton, kg/㎘, kg/10³㎥) — annex3 전용",
      "null": "분류 불가"
    },
    "기호": [
