{
  "별표번호": "8",
  "별표가지번호": "00",
  "별표제목": "최종방류구별 배출량 산정 기준",
  "법령명": "물환경보전법 시행규칙",
  "관련조문": "제15조제2항제1호",
  "개정일": "2019-12-20",
  "산정개요": "오염부하량 할당대상자는 최종방류구별로 배출수의 수질을 일정한 주기로 30회 이상 측정한 자료를 이용하여 할당된 오염부하량을 준수하기 위한 최종방류구별 배출량을 다음과 같이 산정한다.",
  "산정방법": [
    {
      "no": "가",
      "title": "수질 측정 결과가 대수정규분포(log-normal distribution)를 따를 경우",
      "formula": "기준배출수질 = e^(변환평균 + 1.645 × 변환표준편차)",
      "components": {
        "result":   { "name": "기준배출수질", "unit": "mg/L" },
        "factors": [
          { "name": "변환평균",     "description": "log 변환된 측정값들의 평균" },
          { "name": "변환표준편차", "description": "log 변환된 측정값들의 표준편차" },
          { "name": "1.645",       "description": "표준정규분포 상위 95% 신뢰구간 계수" }
        ]
      }
    },
    {
      "no": "나",
      "title": "수질 측정 결과가 대수정규분포를 따르지 않을 경우",
      "formula": "기준배출수질 = (1 - b) × Xa + b × X(a+1)",
      "components": {
        "result": { "name": "기준배출수질", "unit": "mg/L" },
        "factors": [
          { "name": "a", "description": "1 + 0.95 × (측정횟수 - 1) 의 정수부분" },
          { "name": "b", "description": "1 + 0.95 × (측정횟수 - 1) 의 소수부분" },
          { "name": "X1, X2, X3, …, Xa, …, Xn", "description": "배출수 수질을 오름차순으로 서열화한 값" },
          { "name": "Xa",     "description": "측정자료를 오름차순으로 서열화한 값 중 a번째 배출수 수질" },
          { "name": "X(a+1)", "description": "측정자료를 오름차순으로 서열화한 값 중 (a+1)번째 배출수 수질" }
        ]
      }
    }
  ],
  "단위": {
    "최종방류구별 배출량": "L/일",
    "기준배출수질":         "mg/L",
    "할당 오염부하량":      "kg/일"
  },
  "비고": [
    "최종방류구별 배출량의 단위는 1일당 리터(L/일)로 한다.",
    "기준배출수질의 단위는 리터당 밀리그램(mg/L)으로 한다.",
    "할당 오염부하량은 제23조제2항에 따라 최종방류구별로 할당된 오염부하량을 말하며, 그 단위는 1일당 킬로그램(kg/일)으로 한다."
  ]
}
