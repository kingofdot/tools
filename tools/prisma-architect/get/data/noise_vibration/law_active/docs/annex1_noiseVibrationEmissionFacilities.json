            "powerSumWeights": {
              "_note": "동력 합계 산정 시 가중치 (소음배출시설 최소동력기준별)",
              "7.5kW 시설": 1.0,
              "15kW 시설": 0.9,
              "22.5kW 시설": 0.8,
              "37.5kW 또는 75kW 시설": 0.7
