    "비고": [
      "위 가목부터 다목까지의 규정에도 불구하고 기계·기구 및 시설 등이 다음 각 목의 어느 하나에 해당하는 경우로서 사업자가 시·도지사에게 제2호의 시험성적서를 제출하는 경우에는 소음배출시설로 보지 아니한다. 가. 실내에 설치된 경우로서 음향파워레벨이 87dB(A) 이하인 경우. 나. 실외에 설치된 경우로서 음향파워레벨이 77dB(A) 이하인 경우.",
      "위 제1호 각 목에 따른 음향파워레벨은 해당 기계·기구 및 시설 등의 제조·판매자 또는 수입자가 「국가표준기본법」 제23조제2항에 따라 인정을 받은 시험·검사기관(국제기구로부터 인정받은 경우를 포함한다)으로부터 「산업표준화법」에 따른 한국산업표준 방법으로 측정하여 발급받은 시험성적서에 따른다."
    ],
    "비고_정규화": {
      "noiseExemption": {
        "_note": "다음 조건 만족 시 + 시험성적서 제출 시 소음배출시설로 보지 않음",
        "logic": "OR",
        "conditions": [
          { "metric": "soundPowerLevel", "operator": "<=", "value": 87, "unit": "dB(A)", "qualifier": "실내 설치" },
          { "metric": "soundPowerLevel", "operator": "<=", "value": 77, "unit": "dB(A)", "qualifier": "실외 설치" }
        ]
      }
    }
  },
